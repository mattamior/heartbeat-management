{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist",
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "client/**/*.ts", "client/**/*.tsx", "tests/**/*.ts"]
}
