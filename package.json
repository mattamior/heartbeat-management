{
  "name": "heartbeat-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config client/vite.config.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@fastify/static": "latest",
    "fastify": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^9.1.2",
    "tsx": "latest",
    "typescript": "^5.7.2",
    "vitest": "latest"
  }
}
